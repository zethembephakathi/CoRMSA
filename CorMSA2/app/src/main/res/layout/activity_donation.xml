<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/donate">

    <!-- Heading: Donor Information -->
    <TextView
        android:id="@+id/donorInfoHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:text="Donor Information"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"/>

    <!-- Donor Name -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/donorNameLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/donorInfoHeading"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/donorNameEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Donor Name"
            android:inputType="textPersonName"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Heading: Donation Details -->
    <TextView
        android:id="@+id/donationDetailsHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/donorNameLayout"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:text="Donation Details"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"/>

    <!-- Donation Description -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/donationDescriptionLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/donationDetailsHeading"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/donsEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Donation Description"
            android:inputType="textMultiLine"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Remain Anonymous Checkbox -->
    <CheckBox
        android:id="@+id/anonymousCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/donationDescriptionLayout"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:background="@color/lavender"
        android:text="Remain Anonymous"

        android:textColor="@color/black"/>

    <!-- Donate Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/donateButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/anonymousCheckBox"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/red"
        android:text="Donate"
      />

</RelativeLayout>
